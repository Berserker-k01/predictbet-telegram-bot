# Predictbet English Telegram bot — use a SEPARATE BotFather token (not the FR bot)

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=
# Match API (port 59180). In Docker on the same VPS: http://host.docker.internal:59180
PREDICTBET_API_URL=http://187.77.101.57:59180
PREDICTBET_WEB_URL=http://187.77.101.57:59180
SUPPORT_EMAIL=support@predictbet.app
SESSION_FILE=./data/sessions.json

# Web admin panel
ADMIN_PORT=8789
ADMIN_EMAIL=admin@predictbet.app
ADMIN_PASSWORD=change-me
# Public HTTPS URL (required for Paystack webhooks + callback_url)
PUBLIC_URL=https://your-english-domain.com

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Test keys start with sk_test_ / pk_test_. Live keys: sk_live_ / pk_live_
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ENV=test
PAYSTACK_CURRENCY=NGN
